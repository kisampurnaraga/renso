HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Set demo for a frontend-only Vercel preview; api uses the actual backend.
VITE_RENSO_MODE=api
# PostgreSQL/Neon connection string. Never use a VITE_ prefix for secrets.
DATABASE_URL=
# Without these, the app explicitly runs scripted demo sessions.
OPENAI_API_KEY=
OPENAI_MODEL=
DAILY_CHAT_LIMIT=20
