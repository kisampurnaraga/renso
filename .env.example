HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Set demo for a frontend-only Vercel preview; api uses the actual backend.
VITE_RENSO_MODE=api
# PostgreSQL/Neon connection string. Never use a VITE_ prefix for secrets.
DATABASE_URL=
# Select groq or openai. Without a selected provider key/model, chat is demo.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=
# Enable Groq voice input separately after verifying availability in your account.
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Legacy OpenAI configuration remains supported with AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=
DAILY_CHAT_LIMIT=20
